{
  "name": "@tsnx/hosting",
  "version": "0.4.1",
  "description": "TSNX Application Hosting Foundation - DI, Configuration, Logging, Hosted Services, and Application Lifecycle",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.tsbuildinfo",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --noEmit",
    "test": "node ../../scripts/test-runner.js"
  },
  "dependencies": {
    "@tsnx/hosting-abstractions": "workspace:*",
    "@types/node": "^22.13.9"
  }
}
