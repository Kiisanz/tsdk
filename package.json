{
  "name": "tsdk",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "TSDK - TypeScript Development Kit (Engine & Project System inspired by .NET SDK)",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --noEmit",
    "test": "pnpm -r --workspace-concurrency=1 run test"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  }
}
